# Rhizome Configuration
# Copy this file to .env and fill in your values.

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=modernity-v1
# QDRANT_API_KEY=your_qdrant_api_key  # Optional, for Qdrant Cloud

# Embedder type: openai or huggingface
EMBEDDER_TYPE=openai

# OpenAI API key (required if EMBEDDER_TYPE=openai)
OPENAI_API_KEY=your_openai_api_key

# HuggingFace API token (required if EMBEDDER_TYPE=huggingface)
# HF_API_TOKEN=your_hf_token

# HuggingFace model (default: sentence-transformers/all-MiniLM-L6-v2)
# HF_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Wikipedia categories to ingest (comma-separated, also overridable via --categories flag)
WIKIPEDIA_CATEGORIES=Modernism,Postmodernism,Critical theory

# PetScan subcategory depth for Wikipedia article discovery (default: 1)
WIKIPEDIA_DEPTH=1

# Traversal parameters
DEFAULT_DEPTH=8
EPSILON=0.1

# Idea agent (`rhizome idea`) — OpenAI-compatible endpoint serving both
# chat completions and embeddings. No key needed if the gateway is open.
LLM_GATEWAY_URL=https://your-openai-compatible-endpoint
# LLM_GATEWAY_API_KEY=***
LLM_MODEL=auto/best-reasoning
# Must match the embedding model the corpus was built with (1536-dim here)
EMBEDDING_MODEL=openai/text-embedding-3-small
IDEA_MAX_WALKS=3
IDEA_WALK_DEPTH=8
IDEA_MAX_ROUNDS=2
IDEA_MAX_IDEAS=3
